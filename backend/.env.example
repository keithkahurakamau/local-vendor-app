# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/vendor_inventory_db

# --- Secrets ---
SECRET_KEY=change_me
JWT_SECRET_KEY=change_me_too

# --- Frontend ---
# Vite dev server runs on 5173. Set this to the deployed origin in production;
# it is added to the CORS allowlist and used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# --- M-Pesa (Safaricom Daraja sandbox) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
# Safaricom cannot reach localhost. Run `ngrok http 5000` and paste the URL here.
MPESA_CALLBACK_URL=https://<your-ngrok-id>.ngrok-free.app/api/customer/callback

# --- Cloudinary (storefront + menu images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OpenAI (optional: AI menu descriptions; falls back to canned text if unset) ---
OPENAI_API_KEY=

# --- Google Sign-In ---
# Must match GOOGLE_CLIENT_ID used by the frontend.
GOOGLE_CLIENT_ID=

# --- Email (Gmail app password, used for password resets) ---
MAIL_USERNAME=
MAIL_PASSWORD=
